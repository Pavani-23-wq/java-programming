
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = Math.abs(sc.nextInt());
        int even = 0, odd = 0;

        while (n > 0) {
            int d = n % 10;

            if (d % 2 == 0)
                even += d;
            else
                odd += d;

            n /= 10;
        }

        System.out.println("Even Sum = " + even);
        System.out.println("Odd Sum = " + odd);
    }
}
