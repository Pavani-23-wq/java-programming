
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int a = Math.abs(sc.nextInt());
        int b = Math.abs(sc.nextInt());

        int x = a, y = b;

        while (y != 0) {
            int temp = y;
            y = x % y;
            x = temp;
        }

        if (a == 0 || b == 0)
            System.out.println("LCM = 0");
        else
            System.out.println("LCM = " + (a / x) * b);
    }
}
